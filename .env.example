DJANGO_SECRET_KEY=change-me-en-local-uniquement
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Providers préconfigurés par migration (clés vides, à saisir dans l'UI
# Paramètres → Providers et modèles, jamais ici) :
# OpenRouter -> https://openrouter.ai/api/v1 (clé sk-or-...)
# OpenCode Zen -> https://opencode.ai/zen/v1 (clé Zen, modèles chat/completions uniquement)
# OpenCode Go  -> https://opencode.ai/zen/go/v1 (clé Zen/Go, abonnement $10/mois)
# LM Studio  -> http://localhost:1234/v1 (clé souvent vide / lm-studio, à ajouter)
# Ollama     -> http://localhost:11434/v1 (clé souvent vide / ollama, à ajouter)
JEJEGPT_DEFAULT_TEMPERATURE=0.7
JEJEGPT_HTTP_TIMEOUT=30
# Style imposé aux nouvelles conversations (vide = aucun). Le défaut ci-dessous
# exige des réponses Markdown structurées (titres, listes, tableaux) :
# JEJEGPT_DEFAULT_SYSTEM_PROMPT=Tu réponds toujours en Markdown français structuré.
